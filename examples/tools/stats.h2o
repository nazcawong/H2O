# H2O 文字統計。v0.6 驗收檔。
#   ./h2o run examples/tools/stats.h2o
#   ./h2o build examples/tools/stats.h2o -o /tmp/h2o-stats

def id_int(n: Int) -> Int:
    n

def id_text(s: Text) -> Text:
    s

def is_zero(n: Int) -> Bool:
    n == 0

def is_pos(n: Int) -> Bool:
    n > 0

def is_neg(n: Int) -> Bool:
    n < 0

def succ(n: Int) -> Int:
    n + 1

def pred(n: Int) -> Int:
    n - 1

def twice(n: Int) -> Int:
    n + n

def add3(a: Int, b: Int, c: Int) -> Int:
    a + b + c

def min2(a: Int, b: Int) -> Int:
    if a < b:
        a
    else:
        b

def max2(a: Int, b: Int) -> Int:
    if a > b:
        a
    else:
        b

def abs_int(n: Int) -> Int:
    if n < 0:
        0 - n
    else:
        n

def clamp(n: Int, lo: Int, hi: Int) -> Int:
    max2(lo, min2(n, hi))


