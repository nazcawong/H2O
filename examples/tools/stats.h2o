def sum_list(xs: List[Int]) -> Int:
    foldl(xs, 0, fn(acc, x): acc + x)

def count_list[A](xs: List[A]) -> Int:
    foldl(xs, 0, fn(acc, x): acc + 1)

def all_pos(xs: List[Int]) -> Bool:
    not any(xs, fn(n): n <= 0)

def summarize(xs: List[Int]) -> Int:
    sum_list(xs) + count_list(xs)

def not_empty(s: Text) -> Bool:
    s != ""

def main():
    xs = [1, 2, 3, 4, 5]
    n = summarize(xs)
    n = step_1(n)
    n = step_2(n)
    n = clamp(n, 0, 1000)
    txt = io.read_file("examples/core0_hello.h2o")
    if not_empty(txt) and is_pos(n):
        println("stats-ok")
